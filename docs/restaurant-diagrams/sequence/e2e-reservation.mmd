sequenceDiagram
    autonumber
    actor CU as customer
    actor W as waiter
    actor S as security
    participant API as Laravel API
    participant DB as Database

    CU->>API: GET /api/tables/available?date=&party_size=
    API-->>CU: 200 available tables and time slots
    CU->>API: POST /api/reservations (type=Application, party_size, date, special_requests)
    API->>DB: reservation status=Pending, reservation_code generated
    API-->>CU: 201 reservation_code
    W->>API: GET /api/reservations?status=Pending
    API-->>W: 200 pending list
    W->>API: PATCH /api/reservations/:id (status=Confirmed)
    W->>API: POST /api/reservations/:id/tables (table_id, start_time, end_time)
    API->>DB: reservation_table row created
    Note over CU: guests travel to the restaurant
    CU->>S: shows reservation_code at the entrance
    S->>API: GET /api/reservations?reservation_code=...
    API-->>S: 200 reservation + customer.ban + party_size
    alt banned or over capacity
        S-->>CU: entry denied
    else clear to enter
        S-->>W: guests approved, seat them
        W->>API: PATCH /api/reservations/:id (checked_in via order creation)
    end
