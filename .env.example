APP_NAME=Flavor
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Damascus
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=flavor
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_DRIVER=file
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@flavor.test"
MAIL_FROM_NAME="${APP_NAME}"

FLAVOR_TAGLINE="Kitchen, floor and books in one place"
FLAVOR_EMAIL=hello@flavor.test
FLAVOR_PHONE="+963 11 000 0000"
FLAVOR_ADDRESS="Straight Street, Damascus"
FLAVOR_CURRENCY=SYP
FLAVOR_CURRENCY_SYMBOL=SYP

FLAVOR_LOW_STOCK_THRESHOLD=20
FLAVOR_CRITICAL_STOCK_THRESHOLD=5
FLAVOR_DELIVERY_BUFFER=15
FLAVOR_BAN_DAYS=7
FLAVOR_CANCELLATION_LIMIT=5
FLAVOR_OPENING_HOUR=10
FLAVOR_CLOSING_HOUR=24

FLAVOR_MEDIA_DISK=public
FLAVOR_CACHE_ENABLED=true
FLAVOR_QUEUE_MAIL=mail
FLAVOR_QUEUE_REPORTS=reports
FLAVOR_QUEUE_MAINTENANCE=maintenance
